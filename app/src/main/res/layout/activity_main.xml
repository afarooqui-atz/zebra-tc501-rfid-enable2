<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="16dp">

    <!-- Top Status Bar -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Disconnected (TC501 Sled Ready)"
        android:textColor="#38BDF8"
        android:textStyle="bold"
        android:textSize="14sp"
        android:padding="8dp"
        android:background="#1E293B" />

    <!-- Metrics Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:weightSum="2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="12dp"
            android:layout_marginEnd="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UNIQUE TAGS"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/tvTagCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#F8FAFC"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="12dp"
            android:layout_marginStart="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL READS"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/tvTotalReads"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#F8FAFC"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Antenna Power Slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:background="#1E293B"
        android:padding="10dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RF Power:"
            android:textColor="#CBD5E1"
            android:textSize="13sp" />
        <SeekBar
            android:id="@+id/sliderPower"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:progress="27" />
        <TextView
            android:id="@+id/tvPowerValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="27 dBm"
            android:textColor="#38BDF8"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">
        <Button
            android:id="@+id/btnConnect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CONNECT SLED"
            android:backgroundTint="#0EA5E9"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="6dp" />
        <Button
            android:id="@+id/btnScan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="START SCAN"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF"
            android:enabled="false"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Scanned Tags List -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LIVE TAG INVENTORY"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTags"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#090D16" />

</LinearLayout>
